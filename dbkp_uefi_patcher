BASE_URL_MAGNETIC="$BASE_URL/bin/aloha/fd-files/magnetic"
BASE_URL_VOLBUTTON="$BASE_URL/bin/aloha/fd-files/vol-button"

TARGET_DIR="/dev/tmp/uefi-install"
