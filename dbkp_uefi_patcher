# Define URLs and target paths
BASE_URL="https://raw.githubusercontent.com/arkt-7/nabu-uefi-autopatcher/main"
URL_BUSYBOX="$BASE_URL/bin/busybox"
URL_MAGISK_BOOT="$BASE_URL/bin/magiskboot"
